<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!-- TODO : CONSIDER: Patches between this and the Empire Steam Tank mod too. Allow things to be built at both benches. -->
	<!--If Dwarf mod is present, then update as appropriate.--> 
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Rimhammer - The End Times - Dwarfs</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[@Name="RH_TET_Gyro_WorkBench"]/researchPrerequisites</xpath>
					<value>
						<li>RH_TET_Dwarf_WarmachinesBasic</li>
						<li>RH_TET_Dwarfs_Lighting_Advanced</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[@Name="RH_TET_Gyro_VehiclePartBase"]/recipeMaker/researchPrerequisites</xpath>
					<value>
						<li>RH_TET_Dwarf_WarmachinesBasic</li>
						<li>RH_TET_Dwarfs_Lighting_Advanced</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/Vehicles.VehicleBuildDef[@Name="RH_TET_Gyro_GyrocoptorBlueprint"]/researchPrerequisites</xpath>
					<value>
						<li>RH_TET_Dwarf_WarmachinesBasic</li>
						<li>RH_TET_Dwarfs_Lighting_Advanced</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/Vehicles.VehicleBuildDef[@Name="RH_TET_Gyro_GyrobomberBlueprint"]/researchPrerequisites</xpath>
					<value>
						<li>RH_TET_Dwarf_WarmachinesAdvanced</li>
						<li>RH_TET_Dwarfs_Lighting_Advanced</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>

