<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef Name="RH_TET_GyroWreck_Base" ParentName="NonDeconstructibleAncientBuildingBase" Abstract="True">
		<label>ruined dawi gyro flier</label>
		<description>The remains of a dwarfen flying machine, destroyed in some battle or perhaps by some mishap. Destroy this to see what useful components can be recovered from its wreckage.</description>
		<rotatable>false</rotatable>
		<graphicData>
			<texPath>Things/Vehicles/Destroyed/Destroyed_Gyro</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(6,4)</drawSize>
			<shadowData>
				<volume>(4.1, 0.66, 2.4)</volume>
			</shadowData>
		</graphicData>
		<size>(5,3)</size>
		<fillPercent>0.5</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>2000</MaxHitPoints>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="RH_TET_GyroWreck_Base">
		<defName>RH_TET_Gyro_WreckA</defName>
		<killedLeavings>
			<RH_TET_Gyro_ArmorPlate>1</RH_TET_Gyro_ArmorPlate>
			<Gyro_Piston>1</Gyro_Piston>
			<Gyro_SteamPipes>1</Gyro_SteamPipes>
			<ChunkSlagSteel>6</ChunkSlagSteel>
		</killedLeavings>
	</ThingDef>

	<ThingDef ParentName="RH_TET_GyroWreck_Base">
		<defName>RH_TET_Gyro_WreckB</defName>
		<killedLeavings>
			<RH_TET_Gyro_ArmorPlate>2</RH_TET_Gyro_ArmorPlate>
			<Gyro_SteamPipes>1</Gyro_SteamPipes>
			<Gyro_Blade>2</Gyro_Blade>
			<ChunkSlagSteel>6</ChunkSlagSteel>
		</killedLeavings>
	</ThingDef>

	<ThingDef ParentName="RH_TET_GyroWreck_Base">
		<defName>RH_TET_Gyro_WreckC</defName>
		<killedLeavings>
			<RH_TET_Gyro_ArmorPlate>1</RH_TET_Gyro_ArmorPlate>
			<Gyro_SteamPipes>1</Gyro_SteamPipes>
			<Gyro_SteamChamber>1</Gyro_SteamChamber>
			<ChunkSlagSteel>6</ChunkSlagSteel>
		</killedLeavings>
	</ThingDef>

	<ThingDef ParentName="RH_TET_GyroWreck_Base">
		<defName>RH_TET_Gyro_WreckD</defName>
		<killedLeavings>
			<RH_TET_Gyro_ArmorPlate>1</RH_TET_Gyro_ArmorPlate>
			<Gyro_SteamPipes>1</Gyro_SteamPipes>
			<RH_TET_Gyro_Boiler>1</RH_TET_Gyro_Boiler>
			<ChunkSlagSteel>6</ChunkSlagSteel>
		</killedLeavings>
	</ThingDef>
  
</Defs>
